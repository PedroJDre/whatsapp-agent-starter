# Model: any "provider:model" that LangChain's init_chat_model supports.
MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=change-me
# App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=

# Optional: a team member's WhatsApp number (country code, no +) to alert on handoffs.
HUMAN_NOTIFY_NUMBER=

# Password for /dashboard. Change it.
ADMIN_TOKEN=change-me
